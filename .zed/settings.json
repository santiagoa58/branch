{
  "languages": {
    "CSS": {
      "language_servers": ["tailwindcss-intellisense-css", "!vscode-css-language-server", "..."],
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": ["exec", "vp", "fmt", "--stdin-filepath", "{buffer_path}"]
