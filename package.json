  "scripts": {
    "dev": "node --env-file=.env.local scripts/dev.mjs",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "check": "vp check --deny-warnings && pnpm lint:unused && pnpm check:native-dialogs",
    "check:native-dialogs": "node scripts/check-native-dialogs.mjs",
    "lint": "vp lint --deny-warnings",
    "lint:unused": "knip",
    "format": "vp fmt . --write",
    "format:check": "vp fmt --check",
    "test": "vp test",
    "test:run": "vp test run",
    "test:coverage": "vp test run --coverage",
    "type-check": "tsc --noEmit",
    "audit": "pnpm audit",
    "eval:ai": "AI_EVAL=1 node --env-file=.env.local ./node_modules/vite-plus/bin/vp test run server/ai/eval/live.test.ts"
  },
