{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    },
    {
      "source": "/projects/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/sign-up",
      "destination": "/index.html"
    }
  ],
  "devCommand": "pnpm dev --port $PORT",
  "redirects": [
    {
      "source": "/about",
      "destination": "/",
      "permanent": false
    }
  ]
}
