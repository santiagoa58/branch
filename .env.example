# Public Clerk key only; safe for the frontend bundle. Use the same Clerk instance below.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Server only. Never use a VITE_ prefix for secrets.
CLERK_SECRET_KEY=sk_test_replace_me
# Exact frontend origins allowed in Clerk session tokens, comma separated; no wildcard.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Neon pooled URL for serverless runtime (include SSL parameters from Neon).
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Direct URL, used only by the migration command. Never point previews at production.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
# Server-only Vercel AI Gateway API key. Never use a VITE_ prefix for secrets.
AI_GATEWAY_API_KEY=your_ai_gateway_api_key
# Default model for every AI design stage, as provider/model-id. Chosen during prompt evaluation.
AI_MODEL=provider/model-id
# Optional per-stage overrides:
# AI_MODEL_REQUIREMENTS=
# AI_MODEL_COMPONENTS=
# AI_MODEL_DECISIONS=
# AI_MODEL_API=
# AI_MODEL_DATA_MODEL=
